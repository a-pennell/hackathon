# Synthea runtime + bulk generated bundles (regenerate with scripts/gen_synthea.sh).
# The chosen golden bundle is copied to data/golden/ and IS committed.
tools/synthea/*.jar
data/synthea/

__pycache__/
*.pyc
.DS_Store

# frontend
frontend/node_modules/

# server-start snapshot used by the demo reset endpoint
data/patients/.pristine/

# validated review queues are regenerated by replay during the demo; only the *.raw.json
# model recordings are committed (see README runbook)
data/proposed/*/*.json
!data/proposed/*/*.raw.json
